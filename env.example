# BeBetterYou — environment
# Copy: cp env.example .env.local
# Browse quotes locally with no .env (uses data/quotes.json).
# Add the blocks below for auth, admin, and production.

# --- Auth (local sign-in + dashboard) ---
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
ADMIN_EMAIL=bebetteryou.motivational@gmail.com
# Local admin password (plain). Optional: ADMIN_PASSWORD_HASH instead.
ADMIN_PASSWORD=

# --- Database (production / optional local merge) ---
MONGODB_URI=mongodb://localhost:27017/be-better-you

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=true
NEXT_PUBLIC_GITHUB_ENABLED=false

# --- Vercel asset uploads (required on Vercel for admin quote create and for
#     print files; the print flow has no fallback, since Printful must fetch
#     the artwork from a permanent public url) ---
# BLOB_READ_WRITE_TOKEN=

# --- Site ---
SITE_URL=https://bebetteryou.online
APP_NAME=BeBetterYou
SUPPORT_EMAIL=bebetteryou.motivational@gmail.com

# --- Opt-in features (off unless true) ---
# ENABLE_API_DOCS=true
# ENABLE_PRICING=true
# NEXT_PUBLIC_ENABLE_PRICING=true

# --- Blog (on by default; set false to hide nav, routes and sitemap) ---
# NEXT_PUBLIC_ENABLE_BLOG=false

# --- Books (Amazon affiliate catalog; on by default) ---
# NEXT_PUBLIC_ENABLE_BOOKS=false
# NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=yourtag-20

# --- Analytics (first-party, cookieless; on by default) ---
# NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Salts the daily visitor hash. Falls back to NEXTAUTH_SECRET when unset;
# changing it resets visitor counts for the current day only.
# ANALYTICS_SALT=

# --- Stripe (when ENABLE_PRICING=true) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRICE_STARTER=
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE=
NEXT_PUBLIC_PAYMENT_PROVIDER=stripe

# --- Lemon Squeezy (optional) ---
LEMONSQUEEZY_WEBHOOK_SECRET=
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=

# --- Shop (external storefront; leave empty to keep /shop as "coming soon") ---
# NEXT_PUBLIC_SHOP_URL=https://bebetteryou.printful.me
# NEXT_PUBLIC_SHOP_PROVIDER=Printful

# --- Print shop (quote-on-product via Printful; off unless flag is true) ---
# NEXT_PUBLIC_ENABLE_PRINT_SHOP=true
# PRINTFUL_API_KEY=
# PRINTFUL_STORE_ID=
# Printful v1 has no webhook signing — register the URL with ?secret=<this value>
# PRINTFUL_WEBHOOK_SECRET=
# No processor wired yet; `none` parks orders at awaiting_payment.
# PRINT_PAYMENT_PROVIDER=none

# --- Email (magic link / notifications) ---
RESEND_API_KEY=
FROM_EMAIL=noreply@bebetteryou.online

# --- OpenAI (optional) ---
OPENAI_API_KEY=

# --- Social posting (optional) ---
# Instagram: Meta app + IG Business/Creator linked to Facebook Page
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Threads: same Instagram login, separate Meta token (not META_ACCESS_TOKEN).
# Use case: Access the Threads API. Permissions: threads_basic, threads_content_publish.
# User id: npm run threads:me  (after THREADS_ACCESS_TOKEN is set)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
# Facebook Page (same Meta app; use a Page access token)
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# LinkedIn: org page token (w_organization_social) or member token (w_member_social)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=
LINKEDIN_MEMBER_ID=
# X: OAuth 1.0a user tokens (paid API tier may apply)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# YouTube Shorts: same Google OAuth client as sign-in is fine (GOOGLE_CLIENT_*).
# Add these Authorized redirect URIs on that client:
#   http://localhost:3000/api/social/youtube/callback
#   https://www.bebetteryou.online/api/social/youtube/callback
#   https://bebetteryou.online/api/social/youtube/callback
# Then Dashboard → Social → Connect (saves a refresh token in Mongo on Vercel).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional override if you paste a token instead of using Connect
YOUTUBE_REFRESH_TOKEN=
# public | unlisted | private (default public)
YOUTUBE_PRIVACY=
# Pinterest: business account + trial/standard app. Token scopes: pins:write, boards:read, boards:write
# Board id: npm run pinterest:boards  (after PINTEREST_ACCESS_TOKEN is set)
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# --- Redis / Sentry (optional) ---
REDIS_URL=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
